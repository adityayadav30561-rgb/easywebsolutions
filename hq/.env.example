# PostgreSQL connection string (Neon, Supabase, Railway, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hq?schema=public"

# Public base URL, used to build quote / invoice / invite links
APP_URL="https://hq.easywebsolns.com"

# First platform-admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@easywebsolns.com"
SEED_ADMIN_PASSWORD="change-this-password"
