# Contact form delivery — configure ONE option.

# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@easywebsolns.com
# Must be a sender on a domain verified in Resend
CONTACT_FROM_EMAIL="EasyWebSolns Website <website@easywebsolns.com>"

# Option B: POST enquiries as JSON to a webhook (Zapier, Make, Slack workflow, …)
CONTACT_WEBHOOK_URL=
